-- DRAG
local dragging, dragInput, dragStart, startPos
titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

titleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- CANLI ROBUX KONTROLÜ
nameInput:GetPropertyChangedSignal("Text"):Connect(function()
    local text = nameInput.Text
    if #text < 3 then
        statusLabel.Text = "[INSERT] bas veya isim yaz..."
        statusLabel.TextColor3 = Color3.fromRGB(150, 150, 170)
        avatarImage.Image = "rbxassetid://0"
        return
    end

    statusLabel.Text = "Kontrol ediliyor..."
    statusLabel.TextColor3 = Color3.fromRGB(200, 200, 100)

    task.spawn(function()
        local success, userId = pcall(function()
            return Players:GetUserIdFromNameAsync(text)
        end)

        if nameInput.Text == text then
            if success and userId then
                avatarImage.Image = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. userId .. "&width=150&height=150&format=png"
                
                local descSuccess, humDesc = pcall(function()
                    return Players:GetHumanoidDescriptionFromUserId(userId)
                end)

                if descSuccess and humDesc then
                    local hasRobuxItems = (humDesc.HatAccessory ~= "" or humDesc.HairAccessory ~= "" or humDesc.FaceAccessory ~= "" or humDesc.NeckAccessory ~= "" or humDesc.ShoulderAccessory ~= "" or humDesc.FrontAccessory ~= "" or humDesc.BackAccessory ~= "" or humDesc.WaistAccessory ~= "" or humDesc.Shirt ~= 0 or humDesc.Pants ~= 0 or humDesc.GraphicTShirt ~= 0 or humDesc.AnimationPack ~= 0)
                    
                    if hasRobuxItems then
                        statusLabel.Text = "✓ AVATARDA ROBUX VAR"
                        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
                    else
                        statusLabel.Text = "✕ AVATARDA ROBUX YOK"
                        statusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
                    end
                else
                    statusLabel.Text = "✓ KULLANICI BULUNDU"
                    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
                end
            else
                statusLabel.Text = "✕ KULLANICI YOK"
                statusLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
                avatarImage.Image = "rbxassetid://0"
            end
        end
    end)
end)

-- R15 ANIMASYON MOTORU
local function applyR15Animations(npc)
    local humanoid = npc:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
    activeAnimations = {}

    local idleAnim = Instance.new("Animation")
    local walkAnim = Instance.new("Animation")
    local jumpAnim = Instance.new("Animation")

    idleAnim.AnimationId = "rbxassetid://507766388"
    walkAnim.AnimationId = "rbxassetid://913402848"
    jumpAnim.AnimationId = "rbxassetid://507765000"

    local trackIdle = animator:LoadAnimation(idleAnim)
    local trackWalk = animator:LoadAnimation(walkAnim)
    local trackJump = animator:LoadAnimation(jumpAnim)

    trackIdle.Priority = Enum.AnimationPriority.Core
    trackWalk.Priority = Enum.AnimationPriority.Movement
    trackJump.Priority = Enum.AnimationPriority.Action

    activeAnimations.idle = trackIdle
    activeAnimations.walk = trackWalk
    activeAnimations.jump = trackJump

    trackIdle:Play(0.1)
    currentAnimState = "Idle"

    humanoid.Jumping:Connect(function(active)
        if active and activeAnimations.jump then
            activeAnimations.jump:Play(0.05)
        end
    end)
end

local function setAnimState(state)
    if currentAnimState == state then return end

    if state == "Walk" then
        if activeAnimations.idle then activeAnimations.idle:Stop(0.15) end
        if activeAnimations.walk then activeAnimations.walk:Play(0.15) end
    elseif state == "Idle" then
        if activeAnimations.walk then activeAnimations.walk:Stop(0.15) end
        if activeAnimations.idle then activeAnimations.idle:Play(0.15) end
    end

    currentAnimState = state
end

-- TEK CHAT MOTORU
local function makeNPCSpeak(msg)
    if not activeNPC or msg == "" then return end
    local head = activeNPC:FindFirstChild("Head")
    if not head then return end

    if TextChatService and TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        pcall(function() TextChatService:DisplayBubble(head, msg) end)
    else
        pcall(function() Chat:Chat(head, msg, Enum.ChatColor.White) end)
    end
end

talkBtn.MouseButton1Click:Connect(function()
    makeNPCSpeak(chatInput.Text)
end)

-- DOKUNMATİK KONTROL
local padHeld = {Up = false, Down = false, Left = false, Right = false}

btnUp.MouseButton1Down:Connect(function() padHeld.Up = true end)
btnUp.MouseButton1Up:Connect(function() padHeld.Up = false end)

btnDown.MouseButton1Down:Connect(function() padHeld.Down = true end)
btnDown.MouseButton1Up:Connect(function() padHeld.Down = false end)

btnLeft.MouseButton1Down:Connect(function() padHeld.Left = true end)
btnLeft.MouseButton1Up:Connect(function() padHeld.Left = false end)

btnRight.MouseButton1Down:Connect(function() padHeld.Right = true end)
btnRight.MouseButton1Up:Connect(function() padHeld.Right = false end)

btnJump.MouseButton1Click:Connect(function()
    if activeNPC then
        local humanoid = activeNPC:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.Jump = true end
    end
end)

local function startControl(npc)
    if moveConnection then moveConnection:Disconnect() end

    local humanoid = npc:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    applyR15Animations(npc)

    moveConnection = RunService.RenderStepped:Connect(function()
        if not npc or not npc.Parent then
            if moveConnection then moveConnection:Disconnect() end
            return
        end

        local moveVector = Vector3.zero
        local cameraCFrame = Workspace.CurrentCamera.CFrame

        if padHeld.Up then moveVector = moveVector + cameraCFrame.LookVector end
        if padHeld.Down then moveVector = moveVector - cameraCFrame.LookVector end
        if padHeld.Left then moveVector = moveVector - cameraCFrame.RightVector end
        if padHeld.Right then moveVector = moveVector + cameraCFrame.RightVector end

        moveVector = Vector3.new(moveVector.X, 0, moveVector.Z)

        if moveVector.Magnitude > 0 then
            humanoid:Move(moveVector.Unit, false)
            setAnimState("Walk")
        else
            humanoid:Move(Vector3.zero, false)
            setAnimState("Idle")
        end
    end)
end

-- ZORUNLU R15 SPAWN MOTORU
local function spawnCharacterByName(targetName)
    if targetName == "" then return end

    spawnBtn.Text = "YÜKLENİYOR..."

    task.spawn(function()
        local charModel = nil

        pcall(function()
            local userId = Players:GetUserIdFromNameAsync(targetName)
            if userId then
                local humDesc = Players:GetHumanoidDescriptionFromUserId(userId)
                if humDesc then
                    -- R6 dahi olsa R15 yapısında zorunlu oluşturur
                    charModel = Players:CreateHumanoidModelFromDescription(humDesc, Enum.HumanoidRigType.R15)
                end
            end
        end)

        -- Yedek Kontrol
        if not charModel then
            pcall(function()
                local userId = Players:GetUserIdFromNameAsync(targetName)
                if userId then
                    charModel = Players:CreateHumanoidModelFromUserId(userId)
                end
            end)
        end

        if activeNPC then activeNPC:Destroy() end
        
        if charModel then
            activeNPC = charModel
            activeNPC.Name = targetName

            for _, part in ipairs(activeNPC:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end

            local hrp = activeNPC:FindFirstChild("HumanoidRootPart") or activeNPC:FindFirstChild("Torso") or activeNPC:FindFirstChild("UpperTorso")
            if hrp then hrp.CanCollide = true end

            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                activeNPC:PivotTo(char.HumanoidRootPart.CFrame * CFrame.new(0, 0, -6))
            else
                activeNPC:PivotTo(CFrame.new(0, 5, 0))
            end

            activeNPC.Parent = Workspace

            task.wait(0.1)
            startControl(activeNPC)
        end

        spawnBtn.Text = "SPAWN ET"
    end)
end

spawnBtn.MouseButton1Click:Connect(function()
    spawnCharacterByName(nameInput.Text)
end)

removeBtn.MouseButton1Click:Connect(function()
    if activeNPC then
        activeNPC:Destroy()
        activeNPC = nil
    end
    if moveConnection then moveConnection:Disconnect() end
end)

-- [INSERT] KISAYOLU
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.Insert then
        local chosenName = targetList[math.random(1, #targetList)]
        
        pcall(function()
            setclipboard(chosenName)
        end)

        nameInput.Text = chosenName
        spawnCharacterByName(chosenName)
    end
end)
